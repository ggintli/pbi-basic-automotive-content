
createOrReplace

	ref table 'Dim Calendar'

		column IsLast30Days = IF('Dim Calendar'[Date] > TODAY()-30, 1, 0)
			formatString: 0
			lineageTag: 9c3c1e4a-492d-41a3-98a1-d48593c54662
			summarizeBy: sum

			annotation SummarizationSetBy = Automatic

		column Year = FORMAT('Dim Calendar'[Date], "yyyy")
			lineageTag: 9f1e0c82-e324-4ce4-93dc-d12256ec349b
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column MonthNum = FORMAT('Dim Calendar'[Date], "MM")
			lineageTag: c6fe3a6f-bdc3-42a3-9938-26d797a7f2af
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column MonthName = FORMAT('Dim Calendar'[Date], "MMMM")
			lineageTag: 6e347ab8-8877-4b10-a571-33581440da77
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column YearMonth = FORMAT('Dim Calendar'[Date], "yyyy-MM")
